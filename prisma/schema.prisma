generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  ORDER
  APPOINTMENT_DEPOSIT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  role      UserRole @default(CUSTOMER)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  appointments Appointment[]
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  tagline        String?
  description    String
  benefits       String[]
  ingredients    String[]
  usage          String?
  price          Int
  compareAtPrice Int?
  sku            String?          @unique
  stock          Int              @default(0)
  featured       Boolean          @default(false)
  isActive       Boolean          @default(true)
  categoryId     String
  category       ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  fee       Int
  eta       String
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  accessToken        String            @unique
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email              String
  name               String
  phone              String
  status             OrderStatus       @default(PENDING)
  fulfillment        FulfillmentMethod
  currency           String            @default("NGN")
  subtotal           Int
  deliveryFee        Int               @default(0)
  total              Int
  deliveryZoneId     String?
  deliveryZone       DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  addressLine1       String?
  addressLine2       String?
  city               String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              OrderItem[]
  payment            Payment?

  @@index([userId])
  @@index([status])
  @@index([email])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                   String          @id @default(cuid())
  purpose              PaymentPurpose
  status               PaymentStatus   @default(PENDING)
  amount               Int
  currency             String          @default("NGN")
  paystackReference    String          @unique
  paystackAccessCode   String?
  orderId              String?         @unique
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  appointmentId        String?         @unique
  appointment          Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
}

model InfusionService {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  tagline      String
  description  String
  benefits     String[]
  ingredients  String[]
  durationMin  Int
  price        Int
  deposit      Int           @default(0)
  featured     Boolean       @default(false)
  isActive     Boolean       @default(true)
  image        String
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive, featured])
}

model Appointment {
  id          String             @id @default(cuid())
  accessToken String             @unique
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId   String
  service     InfusionService    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus  @default(PENDING)
  name        String
  email       String
  phone       String
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payment     Payment?

  @@index([serviceId])
  @@index([email])
  @@index([status, startsAt])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int
  startMin  Int
  endMin    Int
  slotMin   Int      @default(45)
  bufferMin Int      @default(15)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekday, startMin, endMin])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  image     String?
  featured  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
