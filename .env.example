# Supabase Postgres. Prisma uses this connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Paystack (NGN). Secret stays on the server.
PAYSTACK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# Resend transactional email
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="The Vitamin Spot <hello@thevitaminspot.ng>"

# Admin access. Must match a signed-in Supabase user.
ADMIN_EMAIL="owner@thevitaminspot.ng"
