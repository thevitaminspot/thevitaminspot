# Neon Postgres. Use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# Public site URL — localhost for dev; https://www.thevitaminspotltd.com on Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk — Development keys (pk_test_/sk_test_) for local dev only.
# Production keys (pk_live_/sk_live_) go on Vercel; they reject localhost origins.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Cloudinary. Use the API environment variable from the dashboard.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Paystack (NGN). Secret stays on the server.
PAYSTACK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# Resend — verify thevitaminspotltd.com at resend.com/domains first (see RESEND_DOMAIN.md)
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="The Vitamin Spot <hello@thevitaminspotltd.com>"

# Admin access. Must match a signed-in Clerk user, or set that user's public metadata role to admin.
ADMIN_EMAIL="thevitaminspotltd@gmail.com"

# Optional. Protects GET /api/health/email detailed status (Authorization: Bearer … or ?token=).
HEALTH_PROBE_TOKEN=""

# Vercel Web Analytics API. Create a token at vercel.com/account/tokens.
# VERCEL_PROJECT_ID and VERCEL_ORG_ID are set automatically on Vercel.
VERCEL_API_TOKEN=""

# Upstash Redis (recommended via Vercel Marketplace: `vercel install upstash`).
# Used for distributed rate limiting; falls back to in-memory limiting when unset.
# Also accepts Vercel Marketplace's KV_REST_API_URL / KV_REST_API_TOKEN aliases.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional. Sentry error monitoring (`npx vercel install sentry`).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
