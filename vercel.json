{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/schedules/reminders/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "lounge-maintenance": {
      "schedule": "0 * * * *",
      "timezone": "Africa/Lagos",
      "jitter": 15,
      "function": "api/schedules/reminders"
    }
  }
}
